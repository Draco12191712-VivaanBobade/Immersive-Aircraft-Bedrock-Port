{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ia.item3d": {
      "arrays": {
        "textures": {
          "Array.ia_vv": [
            "Texture.default",
            "Texture.vm",
            "Texture.vn",
            "Texture.v0"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.ia_vv[(q.is_pack_setting_enabled('ia:vv_mers') ? 0 : 2) + (q.is_pack_setting_selected('ia:vv_surface', 'none') ? 1 : 0)]"
      ]
    }
  }
}
