{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.ia.ordnance": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.ia_vv_default[(q.is_pack_setting_selected('ia:vv_surface', 'height') ? (q.is_pack_setting_enabled('ia:vv_mers') ? 4 : 5) : ((q.is_pack_setting_enabled('ia:vv_mers') ? 0 : 2) + (q.is_pack_setting_selected('ia:vv_surface', 'none') ? 1 : 0)))]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "rocket": "q.property('ia:kind') == 0"
        },
        {
          "missile": "q.property('ia:kind') == 1"
        },
        {
          "bomb": "q.property('ia:kind') == 2"
        },
        {
          "bomblet": "q.property('ia:kind') == 3"
        },
        {
          "torpedo": "q.property('ia:kind') == 4"
        },
        {
          "depth": "q.property('ia:kind') == 5"
        },
        {
          "shell": "q.property('ia:kind') == 6"
        },
        {
          "flare": "q.property('ia:kind') == 7"
        }
      ],
      "arrays": {
        "textures": {
          "Array.ia_vv_default": [
            "Texture.default",
            "Texture.default_vm",
            "Texture.default_vn",
            "Texture.default_v0",
            "Texture.default_vmh",
            "Texture.default_vh"
          ]
        }
      }
    }
  }
}
