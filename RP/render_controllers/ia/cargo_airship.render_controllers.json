    "controller.render.ia.cargo_airship.banner_0": {
      "geometry": "Geometry.banner_0",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.banner"
      ],
      "is_hurt_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "overlay_color": {
        "r": "math.mod(math.floor(q.property('ia:banner') / 65536), 256) / 255",
        "g": "math.mod(math.floor(q.property('ia:banner') / 256), 256) / 255",
        "b": "math.mod(q.property('ia:banner'), 256) / 255",
        "a": 0.85
      },
      "part_visibility": [
        {
          "*": "q.property('ia:banner') >= 0"
        },
        {
          "lod1": "(q.property('ia:banner') >= 0) && (q.distance_from_camera >= 32)"
        },
        {
          "flag_front": "(q.property('ia:banner') >= 0) && (q.distance_from_camera >= 32)"
        },
        {
          "flag_small": "(q.property('ia:banner') >= 0) && (q.distance_from_camera >= 32)"
        },
        {
          "flag": "(q.property('ia:banner') >= 0) && (q.distance_from_camera >= 32)"
        }
      ]
    },
