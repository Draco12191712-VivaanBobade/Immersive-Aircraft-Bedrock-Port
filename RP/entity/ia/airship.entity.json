{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ia:airship",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "banner": "textures/entity/banner/banner_base",
        "tex1": "textures/ia/entity/airship_color",
        "tex0": "textures/ia/entity/airship",
        "wpn_bb": "textures/ia/entity/bomb_bay",
        "wpn_hc": "textures/ia/entity/heavy_crossbow",
        "wpn_rc": "textures/ia/entity/rotary_cannon",
        "wpn_ts": "textures/ia/entity/telescope"
      },
      "geometry": {
        "banner_0": "geometry.ia.airship.banner_0",
        "colored_1": "geometry.ia.airship.colored_1",
        "main_0": "geometry.ia.airship.main_0",
        "sails_0": "geometry.ia.airship.sails_0",
        "uncolored_0": "geometry.ia.airship.uncolored_0",
        "wpn_bb_0": "geometry.ia.airship.wpn_bb_0",
        "wpn_hc_0": "geometry.ia.airship.wpn_hc_0",
        "wpn_rc_0": "geometry.ia.airship.wpn_rc_0",
        "wpn_ts_0": "geometry.ia.airship.wpn_ts_0"
      },
      "animations": {
        "main": "animation.ia.airship.main",
        "fx_damage": "animation.ia.airship.fx_damage",
        "fx_bubbles": "animation.ia.airship.fx_bubbles",
        "fx_boost": "animation.ia.airship.fx_boost",
        "fx_engine": "animation.ia.airship.fx_engine",
        "fx_trails": "animation.ia.airship.fx_trails"
      },
      "particle_effects": {
        "smoke": "ia:smoke",
        "flame": "ia:flame",
        "trail": "ia:trail",
        "bubble": "ia:bubble",
        "splash": "ia:splash",
        "firework": "ia:firework",
        "damage": "ia:damage_smoke"
      },
      "scripts": {
        "pre_animation": [
          "v.k = math.clamp(q.delta_time * 15, 0, 1);",
          "v.rx = math.lerprotate(v.rx ?? q.property('ia:rx'), q.property('ia:rx'), v.k);",
          "v.rz = math.lerprotate(v.rz ?? q.property('ia:rz'), q.property('ia:rz'), v.k);",
          "v.ix = math.lerp(v.ix ?? 0, q.property('ia:ix'), v.k);",
          "v.iy = math.lerp(v.iy ?? 0, q.property('ia:iy'), v.k);",
          "v.iz = math.lerp(v.iz ?? 0, q.property('ia:iz'), v.k);",
          "v.power = q.property('ia:engine');",
          "v.eng_rot = math.mod((v.eng_rot ?? 0) + math.min(q.delta_time, 0.25) * 20 * q.property('ia:prop'), 36);",
          "v.time = math.mod(q.time_stamp, 24000) / 20;",
          "v.a0y = math.lerprotate(v.a0y ?? q.property('ia:aim0y'), q.property('ia:aim0y'), v.k);",
          "v.a0p = math.lerp(v.a0p ?? q.property('ia:aim0p'), q.property('ia:aim0p'), v.k);",
          "v.spin0 = q.property('ia:spin0');",
          "v.d0x = -math.sin(v.a0y) * math.cos(v.a0p);",
          "v.d0y = -math.sin(v.a0p);",
          "v.d0z = math.cos(v.a0y) * math.cos(v.a0p);",
          "v.w0_rc_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_rc_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_rc_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_rc_0_yaw = -math.atan2(v.w0_rc_0_nx, v.w0_rc_0_nz);",
          "v.w0_rc_0_pitch = -math.atan2(v.w0_rc_0_ny, math.sqrt(v.w0_rc_0_nx * v.w0_rc_0_nx + v.w0_rc_0_nz * v.w0_rc_0_nz));",
          "v.w0_ts_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_ts_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_ts_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_ts_0_yaw = -math.atan2(v.w0_ts_0_nx, v.w0_ts_0_nz);",
          "v.w0_ts_0_pitch = -math.atan2(v.w0_ts_0_ny, math.sqrt(v.w0_ts_0_nx * v.w0_ts_0_nx + v.w0_ts_0_nz * v.w0_ts_0_nz));"
        ],
        "animate": [
          "main",
          {
            "fx_damage": "q.property('ia:health') < 1"
          },
          {
            "fx_bubbles": "q.is_in_water"
          },
          {
            "fx_boost": "q.property('ia:boost') > 0"
          },
          {
            "fx_engine": "q.property('ia:engine') > 0.01"
          },
          {
            "fx_trails": "q.property('ia:trails') && q.property('ia:speed') > 0.01"
          }
        ]
      },
      "render_controllers": [
        "controller.render.ia.airship.banner_0",
        "controller.render.ia.airship.colored_1",
        "controller.render.ia.airship.main_0",
        "controller.render.ia.airship.sails_0",
        "controller.render.ia.airship.uncolored_0",
        "controller.render.ia.airship.wpn_bb_0",
        "controller.render.ia.airship.wpn_hc_0",
        "controller.render.ia.airship.wpn_rc_0",
        "controller.render.ia.airship.wpn_ts_0"
      ],
      "enable_attachables": false
    }
  }
}
