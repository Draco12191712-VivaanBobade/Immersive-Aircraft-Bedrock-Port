      "scripts": {
        "pre_animation": [
          "v.k = math.clamp(q.delta_time * 15, 0, 1);",
          "v.rx = math.lerprotate(v.rx ?? q.property('ia:rx'), q.property('ia:rx'), v.k);",
          "v.rz = math.lerprotate(v.rz ?? q.property('ia:rz'), q.property('ia:rz'), v.k);",
          "v.ix = math.lerp(v.ix ?? 0, q.property('ia:ix'), v.k);",
          "v.iy = math.lerp(v.iy ?? 0, q.property('ia:iy'), v.k);",
          "v.iz = math.lerp(v.iz ?? 0, q.property('ia:iz'), v.k);",
          "v.power = q.property('ia:engine');",
          "v.eng_rot = math.mod((v.eng_rot ?? 0) + math.min(q.delta_time, 0.25) * 20 * q.property('ia:prop'), 36);",
          "v.time = math.mod(q.time_stamp, 24000) / 20;",
          "v.a0y = math.lerprotate(v.a0y ?? q.property('ia:aim0y'), q.property('ia:aim0y'), v.k);",
          "v.a0p = math.lerp(v.a0p ?? q.property('ia:aim0p'), q.property('ia:aim0p'), v.k);",
          "v.spin0 = q.property('ia:spin0');",
          "v.d0x = -math.sin(v.a0y) * math.cos(v.a0p);",
          "v.d0y = -math.sin(v.a0p);",
          "v.d0z = math.cos(v.a0y) * math.cos(v.a0p);",
          "v.a1y = math.lerprotate(v.a1y ?? q.property('ia:aim1y'), q.property('ia:aim1y'), v.k);",
          "v.a1p = math.lerp(v.a1p ?? q.property('ia:aim1p'), q.property('ia:aim1p'), v.k);",
          "v.spin1 = q.property('ia:spin1');",
          "v.d1x = -math.sin(v.a1y) * math.cos(v.a1p);",
          "v.d1y = -math.sin(v.a1p);",
          "v.d1z = math.cos(v.a1y) * math.cos(v.a1p);",
          "v.w0_rc_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_rc_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_rc_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_rc_0_yaw = -math.atan2(v.w0_rc_0_nx, v.w0_rc_0_nz);",
          "v.w0_rc_0_pitch = -math.atan2(v.w0_rc_0_ny, math.sqrt(v.w0_rc_0_nx * v.w0_rc_0_nx + v.w0_rc_0_nz * v.w0_rc_0_nz));",
          "v.w0_ts_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_ts_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_ts_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_ts_0_yaw = -math.atan2(v.w0_ts_0_nx, v.w0_ts_0_nz);",
          "v.w0_ts_0_pitch = -math.atan2(v.w0_ts_0_ny, math.sqrt(v.w0_ts_0_nx * v.w0_ts_0_nx + v.w0_ts_0_nz * v.w0_ts_0_nz));",
          "v.w0_machine_gun_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_machine_gun_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_machine_gun_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_machine_gun_0_yaw = -math.atan2(v.w0_machine_gun_0_nx, v.w0_machine_gun_0_nz);",
          "v.w0_machine_gun_0_pitch = -math.atan2(v.w0_machine_gun_0_ny, math.sqrt(v.w0_machine_gun_0_nx * v.w0_machine_gun_0_nx + v.w0_machine_gun_0_nz * v.w0_machine_gun_0_nz));",
          "v.w0_autocannon_0_nx = (1.0 * v.d0x + 0.0 * v.d0y + -0.0 * v.d0z);",
          "v.w0_autocannon_0_ny = (0.0 * v.d0x + 1.0 * v.d0y + 0.0 * v.d0z);",
          "v.w0_autocannon_0_nz = (0.0 * v.d0x + 0.0 * v.d0y + 1.0 * v.d0z);",
          "v.w0_autocannon_0_yaw = -math.atan2(v.w0_autocannon_0_nx, v.w0_autocannon_0_nz);",
          "v.w0_autocannon_0_pitch = -math.atan2(v.w0_autocannon_0_ny, math.sqrt(v.w0_autocannon_0_nx * v.w0_autocannon_0_nx + v.w0_autocannon_0_nz * v.w0_autocannon_0_nz));",
          "v.w1_rc_0_nx = (1.0 * v.d1x + 0.0 * v.d1y + -0.0 * v.d1z);",
          "v.w1_rc_0_ny = (0.0 * v.d1x + 1.0 * v.d1y + 0.0 * v.d1z);",
          "v.w1_rc_0_nz = (0.0 * v.d1x + 0.0 * v.d1y + 1.0 * v.d1z);",
          "v.w1_rc_0_yaw = -math.atan2(v.w1_rc_0_nx, v.w1_rc_0_nz);",
          "v.w1_rc_0_pitch = -math.atan2(v.w1_rc_0_ny, math.sqrt(v.w1_rc_0_nx * v.w1_rc_0_nx + v.w1_rc_0_nz * v.w1_rc_0_nz));",
          "v.w1_ts_0_nx = (1.0 * v.d1x + 0.0 * v.d1y + -0.0 * v.d1z);",
          "v.w1_ts_0_ny = (0.0 * v.d1x + 1.0 * v.d1y + 0.0 * v.d1z);",
          "v.w1_ts_0_nz = (0.0 * v.d1x + 0.0 * v.d1y + 1.0 * v.d1z);",
          "v.w1_ts_0_yaw = -math.atan2(v.w1_ts_0_nx, v.w1_ts_0_nz);",
          "v.w1_ts_0_pitch = -math.atan2(v.w1_ts_0_ny, math.sqrt(v.w1_ts_0_nx * v.w1_ts_0_nx + v.w1_ts_0_nz * v.w1_ts_0_nz));",
          "v.w1_machine_gun_0_nx = (1.0 * v.d1x + 0.0 * v.d1y + -0.0 * v.d1z);",
          "v.w1_machine_gun_0_ny = (0.0 * v.d1x + 1.0 * v.d1y + 0.0 * v.d1z);",
          "v.w1_machine_gun_0_nz = (0.0 * v.d1x + 0.0 * v.d1y + 1.0 * v.d1z);",
          "v.w1_machine_gun_0_yaw = -math.atan2(v.w1_machine_gun_0_nx, v.w1_machine_gun_0_nz);",
          "v.w1_machine_gun_0_pitch = -math.atan2(v.w1_machine_gun_0_ny, math.sqrt(v.w1_machine_gun_0_nx * v.w1_machine_gun_0_nx + v.w1_machine_gun_0_nz * v.w1_machine_gun_0_nz));",
          "v.w1_autocannon_0_nx = (1.0 * v.d1x + 0.0 * v.d1y + -0.0 * v.d1z);",
          "v.w1_autocannon_0_ny = (0.0 * v.d1x + 1.0 * v.d1y + 0.0 * v.d1z);",
          "v.w1_autocannon_0_nz = (0.0 * v.d1x + 0.0 * v.d1y + 1.0 * v.d1z);",
          "v.w1_autocannon_0_yaw = -math.atan2(v.w1_autocannon_0_nx, v.w1_autocannon_0_nz);",
          "v.w1_autocannon_0_pitch = -math.atan2(v.w1_autocannon_0_ny, math.sqrt(v.w1_autocannon_0_nx * v.w1_autocannon_0_nx + v.w1_autocannon_0_nz * v.w1_autocannon_0_nz));"
        ],
        "animate": [
          "main",
          {
            "fx_damage": "q.property('ia:health') < 1"
