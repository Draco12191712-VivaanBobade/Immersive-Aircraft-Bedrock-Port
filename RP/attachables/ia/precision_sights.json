{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ia:precision_sights.ia3d",
      "item": {
        "ia:precision_sights": "q.is_pack_setting_enabled('ia:items_3d')"
      },
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/ia/items/precision_sights",
        "vm": "textures/ia/items/precision_sights_vm",
        "vn": "textures/ia/items/precision_sights_vn",
        "v0": "textures/ia/items/precision_sights_v0"
      },
      "geometry": {
        "default": "geometry.ia.item3d.precision_sights"
      },
      "animations": {
        "pose": "animation.ia.item3d.pose",
        "react": "animation.ia.item3d.default"
      },
      "scripts": {
        "pre_animation": [
          "v.ia_cy = q.camera_rotation(1);",
          "v.ia_d = math.clamp(math.mod(v.ia_cy - (v.ia_py ?? v.ia_cy) + 540, 360) - 180, -25, 25);",
          "v.ia_py = v.ia_cy;",
          "v.ia_sw = math.lerp(v.ia_sw ?? 0, v.ia_d, 0.15);",
          "v.ia_dm = q.modified_distance_moved;",
          "v.ia_v = math.clamp((v.ia_dm - (v.ia_pm ?? v.ia_dm)) / math.max(q.delta_time, 0.001), 0, 8);",
          "v.ia_pm = v.ia_dm;",
          "v.ia_mv = math.lerp(v.ia_mv ?? 0, math.clamp(v.ia_v / 4.3, 0, 1), 0.2);",
          "v.ia_wb = math.sin(v.ia_dm * 38.17) * v.ia_mv;",
          "v.ia_sp = math.lerp(v.ia_sp ?? 0, v.ia_v > 5.0 ? 1 : 0, 0.1);"
        ],
        "animate": [
          "pose",
          "react"
        ]
      },
      "render_controllers": [
        "controller.render.ia.item3d"
      ]
    }
  }
}
