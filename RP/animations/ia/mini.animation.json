{
  "format_version": "1.8.0",
  "animations": {
    "animation.ia.mini.pose": {
      "loop": true,
      "bones": {
        "ia_held": {
          "rotation": [
            "c.is_first_person ? 27.0 : -20.0",
            "c.is_first_person ? -39.0 : -32.5",
            "c.is_first_person ? -159.0 : 0.0"
          ],
          "position": [
            "0",
            "c.is_first_person ? 14.5 : 19.0",
            "c.is_first_person ? 2.4 : -4.0"
          ],
          "scale": "c.is_first_person ? 1.0 : 0.65"
        }
      }
    },
    "animation.ia.mini.size": {
      "loop": true,
      "bones": {
        "ia_mini": {
          "scale": "v.ia_k"
        }
      }
    },
    "animation.ia.mini.part": {
      "loop": true,
      "bones": {
        "ia_react": {
          "position": [
            "v.ia_sw * 0.04",
            "v.ia_wb * 0.35 + math.sin(q.life_time * 80) * 0.12",
            "0"
          ],
          "rotation": [
            "v.ia_wb * 3",
            "0",
            "v.ia_sw * 0.8"
          ]
        }
      }
    },
    "animation.ia.mini.rumble": {
      "loop": true,
      "bones": {
        "ia_react": {
          "position": [
            "v.ia_sw * 0.04 + math.sin(q.life_time * 3100) * (0.05 + 0.08 * v.ia_mv)",
            "v.ia_wb * 0.3 + math.cos(q.life_time * 2700) * (0.05 + 0.08 * v.ia_mv)",
            "0"
          ],
          "rotation": [
            "v.ia_wb * 2",
            "0",
            "v.ia_sw * 0.6"
          ]
        }
      }
    },
    "animation.ia.mini.aircraft": {
      "loop": true,
      "bones": {
        "ia_react": {
          "position": [
            "0",
            "math.sin(q.life_time * 120) * 0.4 + v.ia_wb * 0.3",
            "0"
          ],
          "rotation": [
            "v.ia_wb * 2 - math.clamp(q.camera_rotation(0), -60, 60) * 0.25",
            "v.ia_sw * 0.4",
            "-v.ia_sw * 2.5"
          ]
        }
      }
    },
    "animation.ia.mini.weapon": {
      "loop": true,
      "bones": {
        "ia_react": {
          "position": [
            "v.ia_sw * 0.03",
            "v.ia_wb * 0.25 - v.ia_sp * 0.8",
            "0"
          ],
          "rotation": [
            "v.ia_wb * 2 + v.ia_sp * 18",
            "0",
            "v.ia_sw * 0.6"
          ]
        }
      }
    },
